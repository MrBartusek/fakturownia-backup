{
  "name": "fakturownia-backup",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted backup of fakturownia.pl invoices",
  "author": "Bartosz Dokurno",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc",
    "lint": "eslint && prettier --check .",
    "format": "prettier --write ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
